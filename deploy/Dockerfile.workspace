FROM node:26.8.1-alpine@sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3 AS web-build

RUN npm install --global pnpm@11.21.0
WORKDIR /source
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/workspace-web/package.json apps/workspace-web/package.json
RUN pnpm install --frozen-lockfile
COPY apps/workspace-web apps/workspace-web
RUN pnpm web:build

FROM ghcr.io/astral-sh/uv:0.12.7@sha256:95f2aa1fe59274951cfe9b0cbc7972e879ff1004bc8945d130a32eb0dbd85945 AS uv

FROM python:3.14.7-slim@sha256:cae66f2ef0ec51a9891263eeee7f987dacf0a9879e8aa9353d5606e0530619a5 AS runtime

ENV PATH="/opt/kitsune/.venv/bin:${PATH}" \
    KITSUNE_WORKSPACE_CONFIG=/etc/kitsune/workspace.toml \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY --from=uv /uv /uvx /usr/local/bin/
WORKDIR /opt/kitsune
COPY pyproject.toml uv.lock ./
COPY packages packages
COPY services/workspace services/workspace
RUN uv sync --frozen --no-dev --package kitsune-workspace

COPY --from=web-build /source/apps/workspace-web/dist /opt/kitsune/static
COPY deploy/workspace.example.toml /etc/kitsune/workspace.toml
COPY deploy/workspace-entrypoint.sh /usr/local/bin/workspace-entrypoint

EXPOSE 8080
ENTRYPOINT ["workspace-entrypoint"]
CMD ["kitsune", "workspace", "serve", "--config", "/etc/kitsune/workspace.toml"]
