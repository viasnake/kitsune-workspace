FROM ghcr.io/astral-sh/uv:0.11.8@sha256:3b7b60a81d3c57ef471703e5c83fd4aaa33abcd403596fb22ab07db85ae91347 AS uv

FROM python:3.12.14-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

ENV PATH="/opt/kitsune/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY --from=uv /uv /uvx /usr/local/bin/
WORKDIR /opt/kitsune
COPY pyproject.toml uv.lock ./
COPY packages packages
RUN uv sync --frozen --no-dev --package kitsune-sdk
COPY examples examples

RUN groupadd --gid 10001 kitsune \
    && useradd --uid 10001 --gid 10001 --no-create-home \
        --shell /usr/sbin/nologin kitsune \
    && install -d -o 10001 -g 10001 /var/lib/kitsune /var/lib/kitsune-outbox

USER 10001:10001

CMD ["kitsune", "--help"]
