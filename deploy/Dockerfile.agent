FROM ghcr.io/astral-sh/uv:0.12.7@sha256:95f2aa1fe59274951cfe9b0cbc7972e879ff1004bc8945d130a32eb0dbd85945 AS uv

FROM python:3.14.7-slim@sha256:cae66f2ef0ec51a9891263eeee7f987dacf0a9879e8aa9353d5606e0530619a5

ENV PATH="/opt/kitsune/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY --from=uv /uv /uvx /usr/local/bin/
WORKDIR /opt/kitsune
COPY pyproject.toml uv.lock ./
COPY packages packages
RUN uv sync --frozen --no-dev --package kitsune-sdk
COPY examples examples

RUN groupadd --gid 10001 kitsune \
    && useradd --uid 10001 --gid 10001 --no-create-home \
        --shell /usr/sbin/nologin kitsune \
    && install -d -o 10001 -g 10001 /var/lib/kitsune /var/lib/kitsune-outbox

USER 10001:10001

CMD ["kitsune", "--help"]
